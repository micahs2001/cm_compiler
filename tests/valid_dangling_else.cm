/* EXPECT: valid
   Dangling else: each 'else' binds to the nearest unmatched 'if'.
   Also an else-if chain and an if/else inside a while.
   (C- has no unary minus, so negatives are written 0 - n.) */

int classify(int x)
{
  if (x < 0)
    if (x < 0 - 100)
      return 0 - 2;
    else
      return 0 - 1;
  else if (x == 0)
    return 0;
  else
    return 1;
}

void main(void)
{
  int n;
  n = input();
  while (n != 0)
  {
    if (classify(n) > 0)
      output(n);
    else
      output(0 - n);
    n = input();
  }
}
