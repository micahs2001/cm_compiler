ProgramNode:
  FunDeclNode: int mod
    Params:
      ParamDeclNode: int a
      ParamDeclNode: int b
    Body:
      CompoundStmtNode:
        Statements:
          ReturnStmtNode:
            BinaryExprNode (-):
              VarExprNode: a (int)
              BinaryExprNode (*):
                BinaryExprNode (/):
                  VarExprNode: a (int)
                  VarExprNode: b (int)
                VarExprNode: b (int)
  FunDeclNode: int gcd
    Params:
      ParamDeclNode: int a
      ParamDeclNode: int b
    Body:
      CompoundStmtNode:
        Statements:
          IfStmtNode:
            Condition:
              BinaryExprNode (==):
                VarExprNode: b (int)
                NumExprNode: 0
            Then:
              ReturnStmtNode:
                VarExprNode: a (int)
            Else:
              ReturnStmtNode:
                CallExprNode: gcd (int)
                  Args:
                    VarExprNode: b (int)
                    CallExprNode: mod (int)
                      Args:
                        VarExprNode: a (int)
                        VarExprNode: b (int)
  FunDeclNode: void main
    Params:
    Body:
      CompoundStmtNode:
        Local Decls:
          VarDeclNode: int x
          VarDeclNode: int y
        Statements:
          ExprStmtNode:
            AssignExprNode:
              LHS:
                VarExprNode: x (int)
              RHS:
                CallExprNode: input (int)
                  Args:
          ExprStmtNode:
            AssignExprNode:
              LHS:
                VarExprNode: y (int)
              RHS:
                CallExprNode: input (int)
                  Args:
          ExprStmtNode:
            CallExprNode: output (unknown-type)
              Args:
                CallExprNode: gcd (int)
                  Args:
                    VarExprNode: x (int)
                    VarExprNode: y (int)
