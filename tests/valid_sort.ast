                        VarExprNode: a (int)
                          Index:
                            VarExprNode: best (int)
                    Then:
                      ExprStmtNode:
                        AssignExprNode:
                          LHS:
                            VarExprNode: best (int)
                          RHS:
                            VarExprNode: i (int)
                  ExprStmtNode:
                    AssignExprNode:
                      LHS:
                        VarExprNode: i (int)
                      RHS:
                        BinaryExprNode (+):
                          VarExprNode: i (int)
                          NumExprNode: 1
          ReturnStmtNode:
            VarExprNode: best (int)
