/* EXPECT: valid
   Global array, array parameters (int a[]), nested while loops,
   if without else, array elements on both sides of '='. */

int data[8];

int indexOfMin(int a[], int lo, int hi)
{
  int i;
  int best;
  best = lo;
  i = lo + 1;
  while (i < hi)
  {
    if (a[i] < a[best])
      best = i;
    i = i + 1;
  }
  return best;
}

void sort(int a[], int n)
{
  int i;
  int j;
  int tmp;
  i = 0;
  while (i < n - 1)
  {
    j = indexOfMin(a, i, n);
    tmp = a[j];
    a[j] = a[i];
    a[i] = tmp;
    i = i + 1;
  }
}

void main(void)
{
  int i;
  i = 0;
  while (i < 8)
  {
    data[i] = input();
    i = i + 1;
  }
  sort(data, 8);
  i = 0;
  while (i < 8)
  {
    output(data[i]);
    i = i + 1;
  }
}
